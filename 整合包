local nvOn = false
local nvOriginal = nil

local function captureLighting()
	if nvOriginal then return end
	nvOriginal = {
		Brightness = Lighting.Brightness,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}
end

local function applyNV(intensity)
	captureLighting()
	local t = math.clamp(intensity, 0, 100) / 100
	Lighting.Brightness = nvOriginal.Brightness + t * 1.5
	Lighting.Ambient = nvOriginal.Ambient + Color3.new(t * 0.3, t * 0.3, t * 0.35)
	Lighting.OutdoorAmbient = nvOriginal.OutdoorAmbient + Color3.new(t * 0.25, t * 0.25, t * 0.3)
end

local function restoreNV()
	if not nvOriginal then return end
	Lighting.Brightness = nvOriginal.Brightness
	Lighting.Ambient = nvOriginal.Ambient
	Lighting.OutdoorAmbient = nvOriginal.OutdoorAmbient
end

