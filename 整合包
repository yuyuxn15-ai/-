local function formatTime(seconds)
	if seconds <= 0 then return "已过期" end
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = math.floor(seconds % 60)
	return string.format("%d 小时 %02d 分 %02d 秒", h, m, s)
end

local function resetAllStates()
	-- 遍历所有 Toggle 强制关闭（会触发 Callback false，停掉线程 + 恢复状态）
	for _, t in ipairs(allToggles) do
		pcall(function()
			t:SetValue(false)
		end)
	end

	-- 兜底：直接关闭状态
	infJumpOn = false
	noclipOn = false
	nvOn = false
	restoreNV()
	holdOn = false
	realtimeTowerOn = false
	realtimeQueue = {}
	showRangeRing = false
	destroyRangeRing()
	harpoonOn = false
	magmaOn = false
	sniperOn = false
	rayOn = false
	boomOn = false
	dragOn = false

	for _, sw in pairs(espSwitches) do
		sw.Active = false
		if sw.Thread then task.cancel(sw.Thread); sw.Thread = nil end
		for _, d in pairs(sw.Items) do
			if d.hl then d.hl:Destroy() end
			if d.bb then d.bb:Destroy() end
		end
		sw.Items = {}
	end

	for _, sw in pairs(attractSwitches) do
		sw.Active = false
	end
end

