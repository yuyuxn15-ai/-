local raycParams = RaycastParams.new()
raycParams.FilterType = Enum.RaycastFilterType.Include
raycParams.IgnoreWater = true

local function cframeAttack(creature, cfg)
	local handle = getHandle(cfg.ToolRealName)
	if not handle then return end
	local part = findBodyPart(creature)
	if not part then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local origin = camera.CFrame.Position
	local dir = part.Position - origin
	if dir.Magnitude < 0.01 then return end
	local container = workspace:FindFirstChild(CONFIG.CreatureContainerName)
	if container then raycParams.FilterDescendantsInstances = { container } end
	local result = workspace:Raycast(origin, dir, raycParams)
	local hitPos = result and result.Position or (origin + dir)
	local lookDir = (hitPos - origin)
	lookDir = lookDir.Magnitude > 0.01 and lookDir.Unit or Vector3.new(0, 0, 1)
	local cf = string.format("~f%.4f,%.4f,%.4f:%.4f,%.4f,%.4fZ%s",
		hitPos.X, hitPos.Y, hitPos.Z, lookDir.X, lookDir.Y, lookDir.Z, cfg.CFrameSuffix)
	pcall(function()
		RemoteFunc:InvokeServer(
			cfg.Token,
			"ToolReplicator",
			cfg.ToolName,
			"~sShoot",
			handle,
			"~t{1=" .. cf .. "}"
		)
	end)
end

