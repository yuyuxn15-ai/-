local function addESPVisual(target, info)
	if not target or not target.Parent then return nil, nil end
	local hl = target:FindFirstChild("__ESP_HL")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "__ESP_HL"
		hl.Adornee = target
		hl.FillColor = info.Color
		hl.FillTransparency = 0.5
		hl.OutlineColor = info.Color
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = target
	end
	local bb = target:FindFirstChild("__ESP_BB")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "__ESP_BB"
		bb.Size = UDim2.new(0, 180, 0, 24)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 99999
		bb.Adornee = target
		local txt = Instance.new("TextLabel")
		txt.Name = "Label"
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.Text = info.Label
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 14
		txt.TextColor3 = info.Color
		txt.TextStrokeTransparency = 0
		txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		txt.Parent = bb
		bb.Parent = target
	end
