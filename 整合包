RunService.RenderStepped:Connect(function()
	local hrp = getHRP()
	if not hrp then return end
	local myPos = hrp.Position
	local now = tick()

	for name, sw in pairs(attractSwitches) do
		if sw.Active then
			local items = findItems(name)
			local count = #items
			for i, item in ipairs(items) do
				if item.Parent then
					if savedState[item] == nil then
						savedState[item] = {
							Anchored = item.Anchored,
							CanCollide = item.CanCollide,
							Massless = item.Massless,
						}
					end
					item.Anchored = true
					item.CanCollide = false
					item.Massless = true
					local angle = (i / count) * math.pi * 2 + now * 2 + (name:byte(1) or 0)
					local wave = math.sin(now * 1.5 + i) * 1.0
					local offset = Vector3.new(
						math.cos(angle) * 6,
						3 + wave,
						math.sin(angle) * 6
					)
					local target = CFrame.new(myPos + offset)
					item.CFrame = item.CFrame:Lerp(target, 0.3)
				end
			end
		else
			for _, item in ipairs(findItems(name)) do
				local s = savedState[item]
				if s and item.Parent then
					item.Anchored = s.Anchored
					item.CanCollide = s.CanCollide
					item.Massless = s.Massless
					savedState[item] = nil
				end
			end
		end
	end
end)

