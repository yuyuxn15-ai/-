local realtimeTowerOn = false
local realtimeTowerThread = nil
local realtimeSeen = {}
local realtimeQueue = {}
local realtimeProcessing = false

local function processQueue()
	if realtimeProcessing then return end
	realtimeProcessing = true
	task.spawn(function()
		while realtimeTowerOn and #realtimeQueue > 0 do
			local info = table.remove(realtimeQueue, 1)
			local tower = findByPath(info.Path)
			if tower then
				local pos = getWorldPos(tower)
				if pos then
					tpTo(pos)
					pushNotify("实时传送到 " .. info.Label)
					task.wait(0.35)
					for _, p in ipairs(findAllPrompts(tower)) do
						triggerPrompt(p)
					end
					local t0 = tick()
					while realtimeTowerOn and tick() - t0 < 20 do
						task.wait(0.2)
						if #findAllPrompts(tower) == 0 then break end
					end
				end
			end
		end
		realtimeProcessing = false
	end)
end

regToggle(TowerTab:Toggle({
	Title = "实时检测信号塔",
	Value = false,
	Callback = function(state)
		realtimeTowerOn = state
		if state then
			realtimeSeen = {}
			realtimeThread = task.spawn(function()
				while realtimeTowerOn do
					task.wait(0.5)
					for _, info in ipairs(CONFIG.SignalTowers) do
						local tower = findByPath(info.Path)
						if tower and not realtimeSeen[info.Label] then
							realtimeSeen[info.Label] = true
							table.insert(realtimeQueue, info)
						elseif not tower and realtimeSeen[info.Label] then
							realtimeSeen[info.Label] = nil
						end
					end
					if #realtimeQueue > 0 then processQueue() end
				end
			end)
			pushNotify("实时检测已开启")
		else
			if realtimeThread then task.cancel(realtimeThread); realtimeThread = nil end
			realtimeQueue = {}
			pushNotify("实时检测已关闭")
		end
	end,
}))

