local function getStartTime()
	local ok, hasFile = pcall(isfile, KEY_TIME_FILE)
	if ok and hasFile then
		local ok2, content = pcall(readfile, KEY_TIME_FILE)
		if ok2 and content then
			local t = tonumber(content)
			if t then return t end
		end
	end
	local now = os.time()
	pcall(function() writefile(KEY_TIME_FILE, tostring(now)) end)
	return now
end

