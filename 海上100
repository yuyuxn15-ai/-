-- 行走速度：开关逻辑
local speedOn = false
local speedThread = nil
local speedBV = nil

local function stopSpeed()
	if speedThread then task.cancel(speedThread); speedThread = nil end
	if speedBV then speedBV:Destroy(); speedBV = nil end
	local hum = getHum()
	if hum then hum.WalkSpeed = CONFIG.DefaultWalkSpeed end
end

local function startSpeed()
	local value = tonumber(speedBox.Text) or CONFIG.DefaultWalkSpeed

	if speedMode == "direct" then
		-- 只设置一次
		local hum = getHum()
		if hum then hum.WalkSpeed = value end

	elseif speedMode == "loop" then
		-- 每 0.1 秒强制设置一次，防止被服务器改回
		speedThread = task.spawn(function()
			while speedOn do
				local hum = getHum()
				if hum then
					hum.WalkSpeed = tonumber(speedBox.Text) or value
				end
				task.wait(0.1)
			end
		end)

	elseif speedMode == "physics" then
		-- 用 BodyVelocity 按输入方向推，突破默认上限
		local char = getChar()
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = getHum()
		if hrp and hum then
			hum.WalkSpeed = 0
			speedBV = Instance.new("BodyVelocity")
			speedBV.MaxForce = Vector3.new(1e5, 0, 1e5)
			speedBV.Velocity = Vector3.new(0, 0, 0)
			speedBV.P = 1e4
			speedBV.Parent = hrp

			speedThread = task.spawn(function()
				while speedOn and speedBV and speedBV.Parent do
					local h = getHum()
					local v = tonumber(speedBox.Text) or value
					if h then
						local dir = h.MoveDirection
						if dir.Magnitude > 0 then
							speedBV.Velocity = Vector3.new(dir.X, 0, dir.Z).Unit * v
						else
							speedBV.Velocity = Vector3.new(0, 0, 0)
						end
					end
					task.wait(0.05)
				end
			end)
		end
	end
end

