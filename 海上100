local function doTowerTeleport(info)
	local tower = findByPath(info.Path)
	if not tower then
		pushNotify(("未找到信号塔：%s"):format(info.Label),
			Color3.fromRGB(230, 90, 90))
		return false
	end
	local pos = getWorldPosition(tower)
	if not pos then
		pushNotify(("无法读取坐标：%s"):format(info.Label),
			Color3.fromRGB(230, 90, 90))
		return false
	end
	if not teleportTo(pos) then
		pushNotify("传送失败", Color3.fromRGB(230, 90, 90))
		return false
	end
	pushNotify(string.format("已传送到 %s | %.2f, %.2f, %.2f",
		info.Label, pos.X, pos.Y, pos.Z), Color3.fromRGB(120, 200, 255))
	task.spawn(function()
		task.wait(0.35)
		local prompts = findAllPrompts(tower)
		if #prompts == 0 then
			pushNotify(("%s 没有可交互的 prompt"):format(info.Label),
				Color3.fromRGB(230, 160, 90))
			return
		end
		for _, prompt in ipairs(prompts) do
			triggerPrompt(prompt)
			task.wait(0.15)
		end
		pushNotify(("%s 已尝试自动捡起"):format(info.Label),
			Color3.fromRGB(120, 220, 160))
	end)
	return true
end

