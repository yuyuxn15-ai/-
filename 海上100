local function getChests()
	local list = {}
	for _, name in ipairs(CONFIG.Containers) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			for _, c in ipairs(folder:GetChildren()) do
				table.insert(list, c)
			end
		end
	end
	return list
end

local function findPrompt(obj)
	if not obj then return nil end
	if obj:IsA("ProximityPrompt") then return obj end
	for _, c in ipairs(obj:GetChildren()) do
		if c:IsA("ProximityPrompt") then return c end
	end
	local found = obj:FindFirstChildOfClass("ProximityPrompt")
	if found then return found end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("ProximityPrompt") then return d end
	end
	return nil
end

local function isChestAvailable(chest)
	local prompt = findPrompt(chest)
	if not prompt then return false end
	if CONFIG.CheckEnabled and prompt.Enabled == false then return false end
	return true
end

local function countChests()
	local chests = getChests()
	local available = 0
	for _, chest in ipairs(chests) do
		if isChestAvailable(chest) then available += 1 end
	end
	return #chests, available, chests
end

local lastChest = nil
local function pickChest(list)
	if #list == 0 then return nil end
	if CONFIG.TargetIndex then
		local idx = math.clamp(CONFIG.TargetIndex, 1, #list)
		return list[idx]
	end
	local chest = list[math.random(1, #list)]
	if #list > 1 and chest == lastChest then
		local idx = table.find(list, chest)
		if idx then chest = list[(idx % #list) + 1] end
	end
	lastChest = chest
	return chest
end

local function updateCount()
	local total, available = countChests()
	countLabel.Text = ("宝箱：%d | 未开：%d"):format(total, available)
end

local function doTeleport()
	local total, available, chests = countChests()
	countLabel.Text = ("宝箱：%d | 未开：%d"):format(total, available)
	if total == 0 then
		pushNotify("未找到任何宝箱", Color3.fromRGB(230, 90, 90))
		return
	end
	local candidates = {}
	for _, chest in ipairs(chests) do
		if isChestAvailable(chest) then table.insert(candidates, chest) end
	end
	if #candidates == 0 then
		pushNotify(("所有宝箱都已被打开（共 %d 个）"):format(total),
			Color3.fromRGB(230, 160, 90))
		return
	end
	local chest = pickChest(candidates)
	local pos = getWorldPosition(findPrompt(chest))
	if not pos then
		pushNotify("读取宝箱坐标失败", Color3.fromRGB(230, 90, 90))
		return
	end
	if teleportTo(pos) then
		pushNotify(string.format("已传送到未开宝箱 | %.0f, %.0f, %.0f",
			pos.X, pos.Y, pos.Z))
	else
		pushNotify("传送失败", Color3.fromRGB(230, 90, 90))
	end
end

local function setAllHoldDuration(value)
	local chests = getChests()
	local changed = 0
	for _, chest in ipairs(chests) do
		local prompt = findPrompt(chest)
		if prompt and prompt.HoldDuration ~= value then
			prompt.HoldDuration = value
			changed += 1
		end
	end
	return changed
end

