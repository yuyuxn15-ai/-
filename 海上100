local autoChecked = false
local autoThread = nil
local seenTargets = setmetatable({}, {__mode = "k"})
local lastAutoTp = 0

local function stopAuto()
	if autoThread then task.cancel(autoThread); autoThread = nil end
end

local function startAuto()
	stopAuto()
	seenTargets = setmetatable({}, {__mode = "k"})
	local initial = getMetalTargets()
	for _, t in ipairs(initial) do seenTargets[t] = true end
	local lastCount = #initial
	autoThread = task.spawn(function()
		while autoChecked do
			task.wait(CONFIG.AutoCheckInterval)
			if not autoChecked then break end
			local list = getMetalTargets()
			local count = #list
			if count ~= lastCount then
				lastCount = count
				local newTarget = nil
				for _, t in ipairs(list) do
					if not seenTargets[t] then newTarget = t; break end
				end
				for _, t in ipairs(list) do seenTargets[t] = true end
				if newTarget then
					local pos = getWorldPosition(newTarget)
					if pos then
						local now = os.clock()
						local canTp = (now - lastAutoTp) >= CONFIG.AutoTpCooldown
						if canTp then
							local char = LocalPlayer.Character
							local hrp = char and char:FindFirstChild("HumanoidRootPart")
							if hrp then
								local dist = (hrp.Position - pos).Magnitude
								if dist < CONFIG.AutoTpMinDist then canTp = false end
							end
						end
						if canTp and teleportTo(pos) then
							lastAutoTp = now
							pushNotify(string.format(
								"自动传送：新金币宝箱(%s) | %.0f, %.0f, %.0f",
								newTarget.Name, pos.X, pos.Y, pos.Z
							), Color3.fromRGB(220, 190, 110))
						end
					end
				end
			end
		end
	end)
end

