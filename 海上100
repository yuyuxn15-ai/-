local function processRealtimeQueue()
	if realtimeProcessing then return end
	realtimeProcessing = true
	task.spawn(function()
		while realtimeTowerOn and #realtimeQueue > 0 do
			local info = table.remove(realtimeQueue, 1)
			local tower = findByPath(info.Path)
			if tower then
				local pos = getWorldPosition(tower)
				if pos and teleportTo(pos) then
					pushNotify(string.format("实时传送 %s", info.Label),
						Color3.fromRGB(120, 200, 255))
					task.wait(0.35)
					local prompts = findAllPrompts(tower)
					for _, p in ipairs(prompts) do triggerPrompt(p) end
					local waitStart = tick()
					while realtimeTowerOn and tick() - waitStart < 20 do
						task.wait(0.2)
						local remaining = findAllPrompts(tower)
						if #remaining == 0 then
							pushNotify(string.format("%s 已捡完", info.Label),
								Color3.fromRGB(120, 220, 160))
							break
						end
					end
				end
			end
		end
		realtimeProcessing = false
	end)
end

local function startRealtimeTower()
	realtimeTowerOn = true
	realtimeSeen = {}
	realtimeTowerThread = task.spawn(function()
		while realtimeTowerOn do
			task.wait(0.5)
			if not realtimeTowerOn then break end
			for _, info in ipairs(CONFIG.SignalTowers) do
				local tower = findByPath(info.Path)
				local key = info.Label
				if tower and not realtimeSeen[key] then
					realtimeSeen[key] = true
					table.insert(realtimeQueue, info)
					pushNotify(("检测到 %s，加入队列"):format(key),
						Color3.fromRGB(120, 200, 255))
				elseif not tower and realtimeSeen[key] then
					realtimeSeen[key] = nil
				end
			end
			if #realtimeQueue > 0 then processRealtimeQueue() end
		end
	end)
end

local function stopRealtimeTower()
	realtimeTowerOn = false
	if realtimeTowerThread then
		task.cancel(realtimeTowerThread)
		realtimeTowerThread = nil
	end
	realtimeQueue = {}
	realtimeProcessing = false
end

