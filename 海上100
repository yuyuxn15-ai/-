local function findESPTargets(name)
	local list = {}
	local field = workspace:FindFirstChild(CONFIG.DebrisFieldName)
	if not field then return list end
	for _, child in ipairs(field:GetChildren()) do
		local target = child:FindFirstChild(name, true)
		if target then table.insert(list, target) end
	end
	return list
end

local function addESPVisual(target, espInfo)
	if not target or not target.Parent then return nil, nil end
	local hl = target:FindFirstChild("__ESP_HL")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "__ESP_HL"
		hl.Adornee = target
		hl.FillColor = espInfo.Color
		hl.FillTransparency = 0.5
		hl.OutlineColor = espInfo.Color
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = target
	end
	local bb = target:FindFirstChild("__ESP_BB")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "__ESP_BB"
		bb.Size = UDim2.new(0, 180, 0, 26)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 99999
		bb.Adornee = target
		local txt = Instance.new("TextLabel")
		txt.Name = "Label"
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.Text = espInfo.Label
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 14
		txt.TextColor3 = espInfo.Color
		txt.TextStrokeTransparency = 0
		txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		txt.Parent = bb
		bb.Parent = target
	end
	return hl, bb
end

local function clearESPVisual(hl, bb)
	if hl and hl.Parent then hl:Destroy() end
	if bb and bb.Parent then bb:Destroy() end
end

local function startESP(sw)
	sw.Items = setmetatable({}, {__mode = "k"})
	sw.Thread = task.spawn(function()
		while sw.Active do
			local list = findESPTargets(sw.Name)
			for _, target in ipairs(list) do
				if not sw.Items[target] then
					local hl, bb = addESPVisual(target, sw)
					if hl and bb then sw.Items[target] = { hl = hl, bb = bb } end
				end
			end
			for target, data in pairs(sw.Items) do
				if not target.Parent or not data.bb.Parent then
					clearESPVisual(data.hl, data.bb)
					sw.Items[target] = nil
				end
			end
			task.wait(0.4)
		end
	end)
end

local function stopESP(sw)
	sw.Active = false
	if sw.Thread then task.cancel(sw.Thread); sw.Thread = nil end
	for _, data in pairs(sw.Items or {}) do clearESPVisual(data.hl, data.bb) end
	sw.Items = {}
end

